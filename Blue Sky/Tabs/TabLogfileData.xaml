<local:Tab x:Class="Blue_Sky.Tabs.TabLogfileData"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:local="clr-namespace:Blue_Sky.Tabs"
           mc:Ignorable="d"
           Loaded="OnControlLoaded">

    <Grid VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch"
          Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Grid.Row="0">
            <Button Content="Open log file..."
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="4"
                    Click="btnLogFile_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <TextBox HorizontalAlignment="Stretch"
                     VerticalAlignment="Top"
                     Margin="4"
                     TextWrapping="NoWrap"
                     IsReadOnly="True"
                     x:Name="txtLogFileDir" />
        </DockPanel>
        <TabControl HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Grid.Row="1"
                    Margin="4">
            <TabItem Header="Information"
                     Padding="8,4">
                <TextBox TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Courier New"
                         IsReadOnly="True"
                         x:Name="txtLogFileInfo" />
            </TabItem>
            <TabItem Header="Warnings"
                     Padding="8,4"
                     x:Name="tabLogFileWarn">
                <TextBox TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Courier New"
                         IsReadOnly="True"
                         x:Name="txtLogFileWarn" />
            </TabItem>
            <TabItem Header="Errors"
                     Padding="8,4"
                     x:Name="tabLogFileError">
                <TextBox TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Courier New"
                         IsReadOnly="True"
                         x:Name="txtLogFileError" />
            </TabItem>
        </TabControl>

    </Grid>
</local:Tab>
