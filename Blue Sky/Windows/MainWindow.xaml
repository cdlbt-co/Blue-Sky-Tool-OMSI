                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource ControlElevationBorderBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Grid>
            </TabItem>
