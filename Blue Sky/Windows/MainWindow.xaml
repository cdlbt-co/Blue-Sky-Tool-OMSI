<Window x:Class="Blue_Sky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blue_Sky"
        mc:Ignorable="d"
        Title="Blue Sky Tool"
        Height="984"
        Width="1280"
        x:Name="BlueSkyWindow"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="4">
        <TabControl HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="4"
                    Grid.ColumnSpan="2">
            <TabItem Header="Map Information"
                     Padding="8,4">
                <Grid VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               Grid.Row="0">
                        <Button Margin="4"
                                Content="Open map..."
                                Click="btnMap_Click"
                                Style="{DynamicResource AccentButtonStyle}"
                                IsDefault="True" />
                        <TextBox Margin="4"
                                 TextWrapping="NoWrap"
                                 IsReadOnly="True"
                                 x:Name="txtMapDir" />
                    </DockPanel>
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="4"
                              Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="380" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <Label Margin="4,4,4,0"
                                       Content="Map Name" />
                                <TextBox Margin="4,0,4,4"
                                         TextWrapping="NoWrap"
                                         IsReadOnly="True"
                                         x:Name="txtMapName" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Margin="4,4,4,0"
                                               Content="Total Tiles" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapTileCount" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Margin="4,4,4,0"
                                               Content="Missing Tiles" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapTileMissing" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Margin="4,4,4,0"
                                               Content="Total Objects" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapObjectCount" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Margin="4,4,4,0"
                                               Content="Missing Objects" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapObjectMissing" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Margin="4,4,4,0"
                                               Content="Total Splines" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapSplineCount" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Margin="4,4,4,0"
                                               Content="Missing Splines" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapSplineMissing" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Margin="4,4,4,0"
                                               Content="Total AI Vehicles" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapAicarCount" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Margin="4,4,4,0"
                                               Content="Missing AI Vehicles" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapAicarMissing" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Margin="4,4,4,0"
                                               Content="Total Humans" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapHumanCount" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Margin="4,4,4,0"
                                               Content="Missing Humans" />
                                        <TextBox Margin="4,0,4,4"
                                                 TextWrapping="NoWrap"
                                                 IsReadOnly="True"
                                                 x:Name="txtMapHumanMissing" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <Grid HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Margin="4,4,4,0"
                                       Grid.Row="0"
                                       Content="Map Description" />
                                <TextBox Margin="4,0,4,4"
                                         TextWrapping="Wrap"
                                         IsReadOnly="True"
                                         Grid.Row="1"
                                         x:Name="txtMapDescription" />
                            </Grid>
                        </Grid>
                        <Image VerticalAlignment="Stretch"
                               HorizontalAlignment="Stretch"
                               Margin="4"
                               Grid.Column="1"
                               x:Name="imgMap" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Tiles"
                     Padding="8,4"
                     x:Name="tabTiles">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="4"
                          Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Label Margin="4,0"
                               VerticalAlignment="Bottom"
                               Grid.Row="0"
                               Content="All tiles:" />
                        <ListView BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  HorizontalAlignment="Stretch"
                                  SizeChanged="ListView_UpdateColumnWidth"
                                  Name="lvTilesList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="File Name">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Courier New"
                                                           Text="{Binding fileName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Objects"
                                                    Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock TextAlignment="Center"
                                                           Text="{Binding objects.Count}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Splines"
                                                    Width="68">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock TextAlignment="Center"
                                                           Text="{Binding splines.Count}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.Resources>
                                <ContextMenu x:Key="lvTilesListMenu">
                                    <MenuItem Header="Show in File Explorer"
                                              Click="ListView_ClickExplore" />
                                    <MenuItem Header="View Details"
                                              Click="lvTilesList_ClickDetail" />
                                </ContextMenu>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                    <Setter Property="Padding"
                                            Value="0" />
                                    <Setter Property="ContextMenu"
                                            Value="{StaticResource lvTilesListMenu}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isMissing}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                        <Trigger Property="IsSelected"
                                                 Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Setter Property="Background"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource ControlElevationBorderBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            <Setter Property="Background"
                                                    Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                    <GridSplitter Grid.Column="1"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Center" />
                    <Grid Margin="4"
                          Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Label Margin="4,0"
