<Window x:Class="Blue_Sky.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blue_Sky"
        xmlns:tabs="clr-namespace:Blue_Sky.Tabs"
        mc:Ignorable="d"
        Title="Blue Sky Tool"
        Height="984"
        Width="1280"
        x:Name="BlueSkyWindow"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="4">
        <TabControl HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="4"
                    Grid.ColumnSpan="2">
            <TabItem Header="Map Information"
                     Padding="8,4"
                     x:Name="tabMap">
                <tabs:TabMapData x:Name="ucTabMap" />
            </TabItem>
            <TabItem Header="Tiles"
                     Padding="8,4"
                     x:Name="tabTiles">
                <tabs:TabTilesData x:Name="ucTabTiles" />
            </TabItem>
            <TabItem Header="Objects"
                     Padding="8,4"
                     x:Name="tabObjects">
                <tabs:TabObjectsData x:Name="ucTabObjects" />
            </TabItem>
            <TabItem Header="Splines"
                     Padding="8,4"
                     x:Name="tabSplines">
                <tabs:TabSplinesData x:Name="ucTabSplines" />
            </TabItem>
            <TabItem Header="AI Vehicles"
                     Padding="8,4"
                     x:Name="tabAicars">
                <tabs:TabAicarsData x:Name="ucTabAicars" />
            </TabItem>
            <TabItem Header="Humans"
                     Padding="8,4"
                     x:Name="tabHumans">
                <tabs:TabHumansData x:Name="ucTabHumans" />
            </TabItem>
            <TabItem Header="Textures"
                     Padding="8,4"
                     x:Name="tabTextures">
                <tabs:TabTexturesData x:Name="ucTabTextures" />
            </TabItem>
            <TabItem Header="Logfile"
                     Padding="8,4"
                     x:Name="tabLogfile">
                <tabs:TabLogfileData x:Name="ucTabLogfile" />
            </TabItem>
            <TabItem Header="About"
                     Padding="8,4">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Label Content="Blue Sky Tool"
                           HorizontalAlignment="Center"
                           FontSize="16" />
                    <Label Content="Release v2.0.0"
                           HorizontalAlignment="Center"
                           FontSize="12" />
                    <Label Content="© 2026 cdlbt.co All rights reserved."
                           HorizontalAlignment="Center" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
